# Re-plug a docked (ejected) iPod so the normal sync runs. Started by
# musicdock-resync.path. install.sh fills in @APP_DIR@ and @HOME@.

[Unit]
Description=Music Dock: re-plug a docked iPod for a sync
After=musicdock-boot.service

[Service]
Type=oneshot
WorkingDirectory=/var/lib/musicdock
ExecStart=/usr/bin/python3 @APP_DIR@/dock_resync.py
Environment=PYTHONUNBUFFERED=1
# For the CONNECTING screen: the bundled display driver and the login
# user's config ([display] invert).
Environment=EPD_LIB=@APP_DIR@/vendor
Environment=MUSICDOCK_CONFIG=@HOME@/.config/musicdock/config.toml
TimeoutStartSec=3min
