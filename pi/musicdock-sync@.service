# Template unit: %I is the device name from the udev rule, e.g. sda1.
# install.sh fills in @APP_DIR@ and @HOME@ and copies this to /etc/systemd/system/.
#
# Runs as root because mounting needs root. Logs go to the journal:
#   journalctl -u 'musicdock-sync@*' -e

[Unit]
Description=Music Dock sync (/dev/%I)
# If the player is docked at power-on, let the boot screen draw first.
After=musicdock-boot.service

[Service]
Type=oneshot
# lgpio (the panel's GPIO library) creates helper files in the working
# directory. The default, /, isn't writable by the login user.
WorkingDirectory=/var/lib/musicdock
# The venv adds pygpod (the iPod database) to the system packages.
ExecStart=@HOME@/musicdock/venv/bin/python @APP_DIR@/dock_sync.py --device /dev/%I
# Runs as root (mounting), so point at the login user's config explicitly;
# "~" in it (cache_dir) is expanded from the config file owner's home.
Environment=MUSICDOCK_CONFIG=@HOME@/.config/musicdock/config.toml
# The bundled Waveshare display driver (vendor/waveshare_epd).
Environment=EPD_LIB=@APP_DIR@/vendor
Environment=PYTHONUNBUFFERED=1
# A first load or a rebuild of a large player can take many hours.
TimeoutStartSec=24h
