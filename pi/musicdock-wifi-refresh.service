# Redraws the resting screen's Wi-Fi indicator after Wi-Fi connects or drops.
# Started by the NetworkManager dispatcher hook (pi/90-musicdock-wifi).
# install.sh fills in @APP_DIR@ and @HOME@.
#   journalctl -u musicdock-wifi-refresh -e

[Unit]
Description=Music Dock Wi-Fi indicator refresh

[Service]
Type=oneshot
# lgpio (the panel's GPIO library) creates helper files in the working
# directory. The default, /, isn't writable by the login user.
WorkingDirectory=/var/lib/musicdock
# Let a flapping connection settle before drawing.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 @APP_DIR@/dock_status.py --refresh
Environment=EPD_LIB=@HOME@/e-Paper/RaspberryPi_JetsonNano/python/lib
Environment=PYTHONUNBUFFERED=1
# The login user's config ([display] invert, etc.).
Environment=MUSICDOCK_CONFIG=@HOME@/.config/musicdock/config.toml
# Waits on the panel lock if another job is drawing (the boot burst can hold
# it for up to 5 minutes).
TimeoutStartSec=10min
